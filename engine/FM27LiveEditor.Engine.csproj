<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>FM27LiveEditor</RootNamespace>
    <AssemblyName>FM27LiveEditor.Engine</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\app\build\icon.ico</ApplicationIcon>
    <Version>0.3.9</Version>
    <!-- Halves the single-file engine (about 35 MB instead of 68 MB). -->
    <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\core\*.cs" />
  </ItemGroup>

</Project>

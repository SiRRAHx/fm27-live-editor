# Build output and dependencies
node_modules/
plugin/bin/
plugin/obj/
engine/bin/
engine/obj/
app/dist/
*.lnk

# User data: save backups never go in the repo
Save backups/
save-backup-*/

# Research data dumps (large, game-specific); notes and scripts stay
research/snapshot-*/
research/*.json
research/*-refs.txt
research/*-ptrs.txt
research/research-registry.txt
research/__pycache__/
tools/**/bin/
tools/**/obj/

# BepInEx bundle (copied from a game install by tools/bundle-bepinex.js)
vendor/bepinex/

# raw game logs and memory diffs (can hold local paths and save names)
research/*-calls-*.txt
research/*-diff.txt

    <Reference Include="$(FM27Dir)\BepInEx\interop\Il2CppSystem.Runtime.dll" Private="false" Condition="Exists('$(FM27Dir)\BepInEx\interop\Il2CppSystem.Runtime.dll')" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="logo64.png" LogicalName="FM27LiveEditor.logo64.png" />
    <EmbeddedResource Include="pencil64.png" LogicalName="FM27LiveEditor.pencil64.png" />
    <EmbeddedResource Include="menubg.png" LogicalName="FM27LiveEditor.menubg.png" />
  </ItemGroup>

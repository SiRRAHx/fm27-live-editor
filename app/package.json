{
  "name": "fm27-live-editor",
  "version": "0.3.13",
  "description": "Free live editor for Football Manager 27",
  "main": "main.js",
  "author": "Liam Harris",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "dist": "electron-builder --win nsis",
    "release": "node scripts/ensure-release.js && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.fm27liveeditor",
    "productName": "FM27 Live Editor",
    "copyright": "Liam Harris",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "build/icon.ico",
      "build/icon.png",
      "build/logo.svg",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine/bin/out/FM27LiveEditor.Engine.exe",
        "to": "engine/FM27LiveEditor.Engine.exe"
      },
      {
        "from": "../vendor/bepinex",
        "to": "bepinex"
      },
      {
        "from": "../plugin/bin/out/FM27LiveEditor.dll",
        "to": "addon/FM27LiveEditor.dll"
      },
      {
        "from": "../THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "FM27-Live-Editor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FM27 Live Editor",
      "uninstallDisplayName": "FM27 Live Editor",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SiRRAHx",
        "repo": "fm27-live-editor",
        "releaseType": "prerelease"
      }
    ]
  },
  "repository": "https://github.com/SiRRAHx/fm27-live-editor",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
